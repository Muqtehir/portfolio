# Optional backend API origin used by other API calls and the Vite development proxy.
VITE_API_URL=https://your-api-domain.example

# Optional EmailJS browser settings for frontend-only contact form delivery.
# Public identifiers have safe defaults in the contact helper for static hosts.
# Set the template's recipient to izzatudeenmuqtehir@gmail.com.
# Use {{name}} and {{email}} in the email body, and set Reply-To to {{reply_to}}.
# The payload also provides {{from_name}}, {{full_name}}, {{user_name}},
# {{user_email}}, {{from_email}}, {{subject}}, and {{message}} for template compatibility.
# Keep the From Email set to the EmailJS-connected sender; visitor email belongs in Reply-To.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
