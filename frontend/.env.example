# Optional backend API origin used by other API calls and the Vite development proxy.
VITE_API_URL=https://your-api-domain.example

# Optional EmailJS browser settings for frontend-only contact form delivery.
# Public identifiers have safe defaults in the contact helper for static hosts.
# Set the template's recipient to izzatudeenmuqtehir@gmail.com.
# The template must use {{from_name}}, {{reply_to}}, {{subject}}, and {{message}}.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
