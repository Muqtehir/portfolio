# Example environment variables for the backend
# Copy this file to `.env` and fill the real values. DO NOT commit your real `.env` to source control.

# Server
PORT=4000

# Admin token used to protect admin endpoints (send with header: x-admin-token)
ADMIN_TOKEN=admintoken9999

# Admin email to receive contact notifications (fallback in code)
ADMIN_EMAIL=izzatudeenmuqtehir@gmail.com

# MongoDB connection string
# Example (replace user/pwd/dbname):
MONGO_URI=mongodb+srv://<db_user>:<db_pass>@cluster0.mongodb.net/<db_name>

# --- SMTP (Nodemailer) configuration ---
# Gmail requires 2FA and an app password for SMTP access.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=your@gmail.com

# Mailtrap is suitable for testing, but it will not deliver to a real inbox:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=<mailtrap_user>
# SMTP_PASS=<mailtrap_pass>
# SMTP_FROM=no-reply@yourdomain.com

# For production, prefer using a dedicated provider (SendGrid, Mailgun, SES) and store secrets securely.
